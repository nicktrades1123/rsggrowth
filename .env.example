# Default: prepare an email draft without sending or storing answers.
# Enable ONLY after deploying and testing the server endpoint described in docs/SUBMISSIONS.md.
NEXT_PUBLIC_DIAGNOSTIC_SUBMISSION_ENABLED=false

# Cloudflare Pages Function secrets (never expose with NEXT_PUBLIC_)
RESEND_API_KEY=
RESEND_FROM_EMAIL=RSG <notifications@rsggrowth.com>
RSG_ALLOWED_ORIGIN=https://rsggrowth.com

# Server-only Career Diagnostic gate. Missing/false fails closed.
CAREER_SUBMISSIONS_ENABLED=false
# Reviews: bind Cloudflare D1 as RSG_REVIEWS_DB (not a string environment variable).
# Generate a separate random 32+ character secret; never use NEXT_PUBLIC_.
RSG_REVIEWS_ADMIN_TOKEN=
# Local operator CLI only; never included in the browser bundle.
RSG_ADMIN_ORIGIN=https://rsggrowth.com

