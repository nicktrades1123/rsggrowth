# Default: prepare an email draft without sending or storing answers.
# Enable ONLY after deploying and testing the server endpoint described in docs/SUBMISSIONS.md.
NEXT_PUBLIC_DIAGNOSTIC_SUBMISSION_ENABLED=false

# Cloudflare Pages Function secrets (never expose with NEXT_PUBLIC_)
RESEND_API_KEY=
RESEND_FROM_EMAIL=RSG <notifications@rsggrowth.com>
RSG_ALLOWED_ORIGIN=https://rsggrowth.com
